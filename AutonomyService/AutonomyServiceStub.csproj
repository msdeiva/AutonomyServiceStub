<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.35.0" />
		<PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
		<PackageReference Include="Grpc.AspNetCore.Web" Version="2.80.0" />
		<PackageReference Include="Grpc.Tools" Version="2.80.0" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\autonomy_service.proto" GrpcServices="Server" />
		<Protobuf Include="Protos\common.proto" GrpcServices="none" />
	</ItemGroup>

</Project>
